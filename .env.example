# TranscribeOps — Environment Variables
# Kopiere diese Datei: cp .env.example .env

# Flask Secret Key (mindestens 32 Zeichen)
# Generieren: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Whisper API Key (leer = keine Authentifizierung)
# Kann zusätzlich über das Whisper-Admin-UI verwaltet werden (mehrere Keys möglich).
WHISPER_API_KEY=

# Hugging Face Token (benötigt für Speaker Diarization)
# https://huggingface.co/settings/tokens
HF_TOKEN=

# Whisper-Admin-UI (Port 8000, Pfad /admin)
# Leer lassen = Admin-UI deaktiviert.
WHISPER_ADMIN_PASSWORD=
# Optional: Session-Secret explizit setzen; sonst wird es aus dem Passwort abgeleitet.
WHISPER_ADMIN_SESSION_SECRET=

# --- GPU (optional) ---------------------------------------------------------
# PyTorch-Wheel-Index für den Whisper-Image-Build. Leer lassen = unverändert
# (das ist der bisherige Stand: der CUDA-Build von PyPI, passend für NVIDIA
# und CPU). Nur für AMD-Karten setzen — zusammen mit docker-compose.rocm.yml:
#   docker compose -f docker-compose.yml -f docker-compose.rocm.yml up -d --build
# TORCH_INDEX=https://download.pytorch.org/whl/rocm6.3

# HSA_OVERRIDE_GFX_VERSION gehört NICHT hierher, sondern direkt in
# docker-compose.rocm.yml — dort liegt die Zeile auskommentiert bereit.
# Nötig nur für Karten, die ROCm nicht offiziell unterstützt (RX 6000er:
# 10.3.0, RX 7600/7700/7800 und Ryzen-APUs: 11.0.0).
# Details: docs/de/amd-gpu.md
